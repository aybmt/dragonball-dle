+}
+
+.stats-subheading {
+  font-size: 0.85rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.6px;
+  color: var(--text-dim);
+  margin-bottom: 10px;
+  text-align: left;
+}
+
+.stats-distribution {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-bottom: 20px;
+}
+
+.dist-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 0.85rem;
+  color: var(--text);
+}
+.dist-label {
+  width: 26px;
+  text-align: right;
+  font-weight: 700;
+  font-variant-numeric: tabular-nums;
+  color: var(--text-dim);
+}
+.dist-bar-wrap {
+  flex: 1;
+  background: rgba(0, 0, 0, 0.3);
+  border-radius: 3px;
+  overflow: hidden;
+  height: 18px;
+  position: relative;
+}
+.dist-bar {
+  height: 100%;
+  background: linear-gradient(90deg, #ff8c1a 0%, #ffb347 100%);
+  border-radius: 3px;
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  padding-right: 6px;
+  color: #1a1004;
+  font-weight: 800;
+  font-size: 0.75rem;
+  min-width: 26px;
